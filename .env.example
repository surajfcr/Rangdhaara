# Copy to .env (run.bat does this for you) and fill in what you need.
# Never commit .env — it holds your passwords and payment keys.

# development | production
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8080
HOST=127.0.0.1
PORT=8080

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DATABASE_PATH=data/rangdhaara.db
STORAGE_DIR=storage
# Where uploaded product photos are saved. Leave as-is for local use; on a host with a separate
# persistent disk, point this at it (e.g. /var/data/uploads) so photos survive redeploys.
UPLOADS_DIR=public/assets/uploads

# ---------------------------------------------------------------- Email
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# Leave SMTP_PASSWORD empty in development: emails are saved to data/outbox
# and one-time codes are printed in the server window instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rangdhaara1620@gmail.com
SMTP_PASSWORD=
MAIL_FROM=Rangdhara Art Studio <rangdhaara1620@gmail.com>
# Where new-order and needs-review alerts go
STORE_ADMIN_EMAIL=rangdhaara1620@gmail.com

# ---------------------------------------------------------------- Payments
# mock        simulated gateway for local testing (refused in production)
# razorpay    Razorpay Checkout + webhooks
# cashfree    Cashfree PG + webhooks
# manual_upi  customer pays your UPI ID; you mark the order paid in /admin
PAYMENT_PROVIDER=mock

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production
CASHFREE_ENV=sandbox

UPI_VPA=8080007684@ybl
UPI_PAYEE_NAME=Rangdhara Art Studio

# ---------------------------------------------------------------- Shipping
# Delivery estimates are calculated from this pincode
ORIGIN_PINCODE=431001
# Business days to pack a handmade order before it leaves the studio
DISPATCH_DAYS=1
SHIPPING_FLAT_PAISE=0
FREE_SHIPPING_THRESHOLD_PAISE=0

# ---------------------------------------------------------------- Store
STORE_NAME=Rangdhara Art Studio
WHATSAPP_NUMBER=918080007684
INSTAGRAM_HANDLE=rangdhaara_
